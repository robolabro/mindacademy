# Django Settings
SECRET_KEY=your-secret-key-here-generate-a-new-one
DEBUG=False
ALLOWED_HOSTS=mindacademy.ro,www.mindacademy.ro,your-app.railway.app

# Database (Railway provides this automatically)
DATABASE_URL=postgresql://user:password@host:port/database

# Site Configuration
SITE_URL=https://mindacademy.ro
CSRF_TRUSTED_ORIGINS=https://mindacademy.ro,https://www.mindacademy.ro,https://your-app.railway.app

# Email Configuration (optional - for sending emails)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Airtable — sincronizare curriculum (Epic 3)
# Token = Personal Access Token (airtable.com/create/tokens) cu scope
# data.records:read + schema.bases:read pe baza cu tabelul Module.
AIRTABLE_TOKEN=pat_your_personal_access_token
AIRTABLE_BASE_ID=app_your_base_id
